# Configuration of the Computer Use Agent: every setting, in one place.
# .env.example is the template, .env is the same file with your own models and
# keys. Keep both in the same order.

# === Models ==================================================================
# PLANNER (ACTIVE_PROFILE): a chat model. It writes the steps for each screen.
ACTIVE_PROFILE=my_planner
# DECIDER: answers the short per-step questions. A decision model (its endpoint
# ends in /v1/systemone) or any chat model. SAME = the planner's model.
DECIDER_PROFILE=my_decider
# ESCALATION: the chat model for the planner rounds after a failed step, e.g. a
# stronger one. SAME = the planner.
ESCALATION_PROFILE=SAME

# === Planner =================================================================
# Output budget of one planner call, in tokens. A reasoning model spends it on
# thinking first: switch its thinking off (<PROFILE>_REQUEST) or keep this high.
PLANNER_MAX_TOKENS=1500
# Seconds a call to a chat model may take.
REQUEST_TIMEOUT=120
# When a planner that can see gets the screenshot: always | failed (only after
# a failed step, for a slow server or a very large screen).
PLANNER_IMAGES=always

# === Decider =================================================================
# Below this probability an answer is not used and the planner decides.
DECIDER_MIN_CONF=0.5
# Probability needed where an answer is acted on without a second opinion: a
# navigation click, a choice between candidates, "the request is complete".
DECIDER_NAV_CONF=0.8
# 1 = a decision model picks navigation clicks itself, without a planner call
# per screen. 0 = the planner plans every click.
DECIDER_NAVIGATES=1
# 1 = ask the decider on every step, also where an exact label match leaves a
# single candidate.
DECIDER_ALWAYS=0
# When the decider gets the screenshot: never | retry (after an unsure answer)
# | always.
DECIDER_IMAGES=retry
# Seconds a decision may take. After two failed calls in a row the decider is
# left out for the rest of the request.
DECIDER_TIMEOUT=15

# === The run =================================================================
# Part of the window title of the application to work in, e.g. HospitalRun.
# Empty = the decider picks the window from the request.
TARGET_WINDOW=
# 1 = nobody attends the run: the agent never asks the user and never pauses by
# itself. For evaluations, usually together with CONTINUE_SESSION=0.
AUTONOMOUS=0
# 1 = a new request continues the conversation. 0 = every request starts fresh.
CONTINUE_SESSION=1
# Executed steps and planner calls allowed per request. A request that is still
# getting on (the decider judges) is granted them again, three times at most.
MAX_STEPS=60
MAX_PLAN_ROUNDS=15

# === Stopping and pausing ====================================================
# Global key that stops the agent before its next action (e.g. ctrl+alt+s).
# Empty = none.
STOP_KEY=pause
# Global key that pauses and resumes the agent.
PAUSE_KEY=scrolllock
# 1 = pause when a person moves the mouse during a run.
PAUSE_ON_POINTER_MOVE=1

# === Reading the screen ======================================================
# When YOLO looks for controls without text (empty fields, icons): needed (a
# step works on a field, or a step failed) | always (with every full read;
# several seconds each on a CPU).
CONTROL_DETECTION=needed
# Share of the window that may change for a partial re-read. Above it the whole
# window is read.
PARTIAL_PARSE_MAX_FRAC=0.35
# Seconds a click may take to change the screen before the screen is read.
CLICK_SETTLE_S=1.5
# YOLO: input resolution (multiple of 32; higher finds smaller icons, slower),
# confidence threshold, overlap threshold between its own boxes.
YOLO_IMGSZ=1920
YOLO_CONF_THRESH=0.05
YOLO_IOU_THRESH=0.3
# Share of a text's area that must lie inside a YOLO box for the text to count
# as that control.
YOLO_TEXT_FUSE_THRESH=0.5
# Removing the blinking text cursor before text is read: frames captured,
# seconds between them, brightness difference (0-255) that counts as blinking,
# width in pixels of the ring sampled around it.
DECARET_FRAMES=4
DECARET_INTERVAL_S=0.18
DECARET_DIFF_THRESH=26
DECARET_RING_PX=3

# === Typing and the mouse ====================================================
# 1 = fields that are certain are typed one after the other, with a pixel
# comparison per field instead of a screen read. 0 = read after every field.
BATCH_ENTRY=1
# Seconds to wait after typing before the picture for that comparison is taken:
# long enough for a list or a calendar to open.
BATCH_SETTLE_S=0.35
# In that comparison a pixel counts as changed only if a colour channel differs
# by more than this many steps of 255. 0 = exact.
BATCH_COLOR_TOLERANCE=8
# 1 = the text cursor has to be seen next to a field's label before the field's
# content is replaced.
FOCUS_CHECK=1
# unicode = every character is sent as itself, whatever the keyboard layout.
# keys = key presses of a US layout (drops '@' and others on a German one), for
# remote sessions that do not pass Unicode input through.
TYPE_MODE=unicode
# Cursor speed, 1 (slowest) to 100 (near-instant). Also set in the console.
MOUSE_GLIDE_SPEED_PCT=30
# 0 = no glide: the cursor jumps to its target.
MOUSE_GLIDE=1
# Longest single wait step, in seconds. 0 = no limit.
WAIT_MAX_S=300

# === Logs ====================================================================
# 1 = keep a log of every request on disk. The logs hold what the screen
# showed, so on a real system they hold patient data.
RUN_LOG=1
# Folder the run logs are collected in. Empty = logs/ next to agent.py.
RUN_LOG_DIR=
# Level of the log lines. Leave at INFO: the console is built from them.
LOG_LEVEL=INFO

# === Model profiles ==========================================================
# A profile is a name with these variables; any number of profiles can stand
# here, and the console lists them all.
#   <PROFILE>_API_KEY, <PROFILE>_ENDPOINT, <PROFILE>_MODEL
#   <PROFILE>_VISION=1|0          the model accepts screenshots (default 1)
#   <PROFILE>_REQUEST='{...}'     JSON merged into every request to that model, e.g.
#                                 '{"chat_template_kwargs":{"enable_thinking":false}}'
#                                 to switch a Qwen or Gemma model's thinking off
#   <PROFILE>_IMAGE_MAX_PIXELS=N  larger screenshots are scaled down before sending

# --- Profile: my_planner (chat) ---
MY_PLANNER_API_KEY=your_api_key
MY_PLANNER_ENDPOINT=https://your-llm-endpoint/v1/chat/completions
MY_PLANNER_MODEL=your-model-name
MY_PLANNER_VISION=1
MY_PLANNER_REQUEST='{"chat_template_kwargs":{"enable_thinking":false}}'

# --- Profile: my_decider (decision model: DECIDER only) ---
MY_DECIDER_API_KEY=your_api_key
MY_DECIDER_ENDPOINT=https://your-llm-endpoint/v1/systemone
MY_DECIDER_MODEL=your-decision-model
MY_DECIDER_VISION=1
