# =============================================================================
#  Multi-Agent Harness — example configuration
#
#  Copy this file to `.env` and fill in your own endpoints, keys and model
#  names. `.env` is gitignored and must never be committed.
#
#      cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
#  Role assignment
#
#    ACTIONER   — drives mouse/keyboard from screenshots. Needs a VISION model.
#    NARRATOR   — reuses the ACTIONER model (also vision); not set separately.
#    SUPERVISOR — text-only planning/oversight. Vision NOT required, so any
#                 profile qualifies.
#
#  Both roles are also switchable at runtime from the web UI.
# -----------------------------------------------------------------------------

# Active profile for the ACTIONER (case-insensitive). Must be vision-capable.
ACTIVE_PROFILE=example_vision

# Profile for the SUPERVISOR. Use SAME (or leave blank) to reuse the actioner
# model for planning as well.
NAVIGATOR_PROFILE=SAME

# -----------------------------------------------------------------------------
#  Generation budgets
# -----------------------------------------------------------------------------

# Output-token budgets. The built-in defaults (700 supervisor / 1024 actioner)
# suit direct-answer models. REASONING models spend the budget on hidden
# thinking before emitting the tool call and get truncated
# (finish_reason=length) — give those models several thousand tokens.
NAVIGATOR_MAX_TOKENS=8192
ACTIONER_MAX_TOKENS=8192

# Per-request timeout in seconds (default 120). A non-streaming vLLM server
# sends nothing until generation completes, so a reasoning model on a contended
# GPU can legitimately exceed 120 s; a timeout then aborts and retries the whole
# generation, which is worse than waiting.
REQUEST_TIMEOUT=300

# -----------------------------------------------------------------------------
#  Model profiles
#
#  A profile is any set of variables sharing a prefix:
#
#      <PROFILE>_ENDPOINT   OpenAI-compatible /v1/chat/completions URL
#      <PROFILE>_API_KEY    bearer token (use a placeholder if unauthenticated)
#      <PROFILE>_MODEL      model name as served by the endpoint
#      <PROFILE>_VISION     1 = vision-capable → offered as Actioner AND
#                           Supervisor in the UI
#                           0 = text-only      → offered as Supervisor ONLY
#                           (missing is treated as 1)
#
#  Any number of profiles may coexist. Both the UI dropdowns and ACTIVE_PROFILE
#  discover them automatically — a profile needs a *_MODEL and an *_ENDPOINT to
#  show up.
# -----------------------------------------------------------------------------

# --- Profile: example_vision (vision-capable → Actioner or Supervisor) ---
EXAMPLE_VISION_ENDPOINT=https://your-llm-host/v1/chat/completions
EXAMPLE_VISION_API_KEY=your_api_key_here
EXAMPLE_VISION_MODEL=your-vision-model-name
EXAMPLE_VISION_VISION=1

# --- Profile: example_text (text-only → Supervisor only) ---
EXAMPLE_TEXT_ENDPOINT=https://your-llm-host/v1/chat/completions
EXAMPLE_TEXT_API_KEY=your_api_key_here
EXAMPLE_TEXT_MODEL=your-text-model-name
EXAMPLE_TEXT_VISION=0

# -----------------------------------------------------------------------------
#  Optional tuning (all have sensible defaults — uncomment to override)
# -----------------------------------------------------------------------------

# --- Perception ---
# YOLO_IMGSZ=1920                 # YOLO input resolution (multiple of 32)
# YOLO_CONF_THRESH=0.05           # YOLO confidence threshold
# YOLO_IOU_THRESH=0.3             # IoU threshold for YOLO-internal NMS
# YOLO_OCR_OVERLAP_THRESH=0.05    # OCR-box fraction a YOLO box must cover to be dropped
# YOLO_TEXT_FUSE_THRESH=0.5       # overlap at which a YOLO box absorbs OCR text

# --- Control loop ---
# SUBTASK_MAX_ITER=8              # actioner steps per subtask before the supervisor is recalled
# NAVIGATOR=1                     # 1 = supervisor enabled, 0 = actioner-only
# NARRATOR=1                      # 1 = per-step narration in the UI
# CONTINUE_SESSION=1              # 1 = keep conversation across tasks

# --- Input behaviour ---
# MOUSE_GLIDE=1                   # 1 = glide the cursor to targets, 0 = jump
# MOUSE_GLIDE_SPEED_PCT=30        # glide speed (also set by the UI slider)

# --- Caret suppression (removes the blinking text caret from screenshots) ---
# DECARET_FRAMES=4
# DECARET_INTERVAL_S=0.18
# DECARET_DIFF_THRESH=26
# DECARET_RING_PX=3

# --- Logging ---
# LOG_LEVEL=INFO
